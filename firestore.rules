rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /sessions/{sessionId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
        allow update: if request.auth != null || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
          request.resource.data.registeredCount is int &&
          request.resource.data.registeredCount > resource.data.registeredCount &&
          request.resource.data.registeredCount <= resource.data.capacity
        );

        match /registrations/{registrationId} {
          // Only the admin may list/read registrations (visitor privacy).
          allow read: if request.auth != null;
          allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'phone2', 'partySize', 'createdAt']) &&
                          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                          request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
                          request.resource.data.email is string &&
                          request.resource.data.phone2 is string &&
                          request.resource.data.partySize is int && request.resource.data.partySize > 0;
          allow update, delete: if request.auth != null;
        }
      }
    }
  }
}
