rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /sessions/{sessionId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
        allow update: if request.auth != null || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
          request.resource.data.registeredCount is int &&
          request.resource.data.registeredCount >= 0 &&
          request.resource.data.registeredCount <= resource.data.capacity
        );

        match /registrations/{registrationId} {
          // Doc ID is a hash of (session, normalized name, normalized phone), so
          // "get" only works if you already know those exact details - it does not
          // let anyone browse the attendee list (that still needs "list", admin-only).
          allow get: if true;
          allow list: if request.auth != null;
          allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'phone2', 'partySize', 'createdAt']) &&
                          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                          request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
                          request.resource.data.email is string &&
                          request.resource.data.phone2 is string &&
                          request.resource.data.partySize is int && request.resource.data.partySize > 0;
          allow update: if request.auth != null;
          // Same "knows the exact ID" model as get: cancellation needs the same
          // name+phone that were used to register.
          allow delete: if true;
        }

        match /waitlist/{waitlistId} {
          // "get" (by exact ID, same hash-of-name+phone model as registrations)
          // is needed so the join form can check for an existing entry before
          // writing. "list" stays admin-only, so no one can browse the queue.
          allow get: if true;
          allow list, update, delete: if request.auth != null;
          allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'phone2', 'partySize', 'createdAt']) &&
                          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                          request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
                          request.resource.data.email is string &&
                          request.resource.data.phone2 is string &&
                          request.resource.data.partySize is int && request.resource.data.partySize > 0;
        }
      }
    }
  }
}
